{
  "name": "pose-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx server.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server.js",
    "setup": "node scripts/setup.mjs",
    "analyze:audio": "uv run --python 3.12 analyze_audio.py",
    "service:install": "node scripts/service.mjs install",
    "service:stop": "node scripts/service.mjs stop",
    "service:status": "node scripts/service.mjs status",
    "test": "node --import tsx --test tests/*.test.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "express": "5.3.0",
    "kalidokit": "^1.1.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  }
}
